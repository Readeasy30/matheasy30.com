Step 1: The Serverless Backend (Cloudflare Worker)This worker acts as your secure API gateway. It hides your free AI API key and structures incoming math problems into clear, jargon-free explanations.Create a new Cloudflare Worker.Add your Gemini API key to the worker's environment variables as GEMINI_API_KEY.Deploy the following code:javascript// index.js - Cloudflare Worker
export default {
  async fetch(request, env) {
    // Handle CORS preflight requests
    if (request.method === "OPTIONS") {
      return new Response(null, {
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "POST, OPTIONS",
          "Access-Control-Allow-Headers": "Content-Type",
        },
      });
    }

    if (request.method !== "POST") {
      return new Response("Method Not Allowed", { status: 405 });
    }

    try {
      const { problem, context } = await request.json();
      
      // Strict system prompting to make math incredibly simple
      const prompt = `You are the core engine of matheasy30. 
      Solve this math problem: "${problem}". 
      Context/Target Audience: ${context}.
      
      Rules:
      1. Explain it like the user has severe math anxiety.
      2. Break it down into maximum 3 micro-steps.
      3. Use a real-world analogy (like pizza slices, hours in a day, or money).
      4. Output raw, clean HTML styling matching Tailwind utility classes. Do not wrap in markdown \`\`\`html blocks. Use text-slate-800, font-bold, etc.`;

      const response = await fetch(
        `https://googleapis.com{env.GEMINI_API_KEY}`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }]
          })
        }
      );

      const data = await response.json();
      const aiResponse = data.candidates[0].content.parts[0].text;

      return new Response(JSON.stringify({ result: aiResponse }), {
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*",
        },
      });

    } catch (error) {
      return new Response(JSON.stringify({ error: error.message }), {
        status: 500,
        headers: { "Access-Control-Allow-Origin": "*" },
      });
    }
  }
};
