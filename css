* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f7fb;
  color: #1d1d1d;
  line-height: 1.6;
}

.wrap {
  width: 92%;
  max-width: 1000px;
  margin: auto;
}

.hero {
  background: linear-gradient(135deg, #4f7cff, #6ea8ff);
  color: white;
  padding: 80px 20px;
  text-align: center;
}

.eyebrow {
  font-size: 14px;
  letter-spacing: 1px;
  text-transform: uppercase;
  opacity: 0.9;
}

h1 {
  font-size: 60px;
  margin: 10px 0;
}

.tagline {
  font-size: 22px;
  max-width: 700px;
  margin: 20px auto 35px;
}

.section {
  padding: 60px 20px;
}

.card {
  background: white;
  padding: 40px;
  border-radius: 24px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.06);
}

.highlight {
  background: #eef4ff;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 25px;
}

.feature-card {
  background: white;
  padding: 30px;
  border-radius: 22px;
  box-shadow: 0 6px 24px rgba(0,0,0,0.05);
}

.feature-card h3 {
  margin-top: 0;
  color: #3461d9;
}

.btn {
  display: inline-block;
  padding: 16px 30px;
  border-radius: 14px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.2s ease;
}

.primary {
  background: white;
  color: #3461d9;
}

.primary:hover {
  transform: translateY(-2px);
}

.center {
  text-align: center;
}

ul {
  padding-left: 20px;
}

footer {
  text-align: center;
  padding: 40px 20px;
  background: #dde7fb;
  font-size: 14px;
}

@media (max-width: 768px) {

  h1 {
    font-size: 42px;
  }

  .tagline {
    font-size: 18px;
  }

  .card,
  .feature-card {
    padding: 24px;
  }

}
